<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PizzaTake.ViewModels"
             xmlns:models="clr-namespace:PizzaTake.Models"
             x:Class="PizzaTake.Views.CheckoutPage"
             x:DataType="vm:CheckoutViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <Label Text="Оплата замовлення"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
            <Label Text="Оберіть зручний спосіб отримання та оплати"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18">
                <!-- Offline Notice -->
                <Border IsVisible="{Binding IsOffline}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="#F59E0B"
                        BackgroundColor="#FEF3C7"
                        Padding="12">
                    <Label Text="Немає інтернету. Замовлення збережеться локально та синхронізується автоматично."
                           FontSize="13"
                           TextColor="#92400E" />
                </Border>

                <!-- Delivery Type -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="СПОСІБ ОТРИМАННЯ"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />

                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectDeliveryTypeCommand}" CommandParameter="Delivery" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Доставка"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                            <Label Grid.Column="1"
                                   Text="●"
                                   IsVisible="{Binding IsDelivery}"
                                   TextColor="#EB5E28"
                                   FontSize="18" />
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectDeliveryTypeCommand}" CommandParameter="Pickup" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="На виніс"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                            <Label Grid.Column="1"
                                   Text="●"
                                   IsVisible="{Binding IsPickup}"
                                   TextColor="#EB5E28"
                                   FontSize="18" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Delivery Address -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsDelivery}">
                    <Label Text="Адреса доставки"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />

                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="14,6">
                        <Entry Text="{Binding DeliveryAddress, Mode=TwoWay}"
                               Placeholder="Введіть назву вулиці та будинок"
                               TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                    </Border>

                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding SavedAddresses}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:UserAddress">
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                                        Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CheckoutViewModel}}, Path=SelectAddressCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Label}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#EB5E28" />
                                        <Label Text="{Binding Text}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Payment Methods -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Спосіб оплати"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />

                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="CardOnline" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Карткою онлайн / Google Pay"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                <Label Text="Visa або Mastercard"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="●" IsVisible="{Binding IsCardOnline}" TextColor="#EB5E28" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="CardOnDelivery" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Карткою при отриманні"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                <Label Text="Термінал у кур'єра або на касі"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="●" IsVisible="{Binding IsCardOnDelivery}" TextColor="#EB5E28" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Cash" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Готівка при отриманні"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                <Label Text="Кур'єру або в ресторані"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="●" IsVisible="{Binding IsCash}" TextColor="#EB5E28" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Order Summary -->
                <Border StrokeShape="RoundRectangle 18"
                        Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                        Padding="16"
                        Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding ItemsCount, StringFormat='Товари · {0} шт.'}"
                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            <Label Grid.Column="1"
                                   Text="{Binding TotalAmount, StringFormat='{0:0.##} ₴'}"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Доставка"
                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            <Label Grid.Column="1"
                                   Text="Безкоштовно"
                                   TextColor="#16A34A"
                                   FontAttributes="Bold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="До сплати"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                            <Label Grid.Column="1"
                                   Text="{Binding TotalAmount, StringFormat='{0:0.##} ₴'}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#EB5E28" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Margin="0,12,0,0"
                Text="Підтвердити оплату"
                Command="{Binding ConfirmPaymentCommand}"
                BackgroundColor="#F7A600"
                TextColor="#FFFFFF"
                FontSize="17"
                FontAttributes="Bold"
                CornerRadius="26"
                HeightRequest="52" />
    </Grid>
</ContentPage>
