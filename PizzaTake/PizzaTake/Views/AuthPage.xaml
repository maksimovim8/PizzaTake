<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PizzaTake.Core.ViewModels;assembly=PizzaTake.Core"
             xmlns:behaviors="clr-namespace:PizzaTake.Behaviors"
             x:Class="PizzaTake.Views.AuthPage"
             x:DataType="vm:AuthViewModel"
             Title="{Binding Title}"
             BackgroundColor="#3B2616">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="24,32">
            <Button Grid.Row="0"
                    Text="‹ Назад"
                    AutomationId="AuthBackButton"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="#FDF1D6"
                    FontSize="16"
                    Padding="0" />

            <!-- Main Auth Card -->
            <Border Grid.Row="1"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 26"
                    StrokeThickness="0"
                    BackgroundColor="#4E3422"
                    Padding="24,36">
                <VerticalStackLayout Spacing="22">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding HeaderTitle}"
                               FontSize="26"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#FFFFFF" />
                        <Label Text="PIZZA.TAKE!"
                               FontSize="30"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#F7A600" />
                    </VerticalStackLayout>

                    <Label Text="{Binding SubtitleText}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="#E7DCD2" />

                    <VerticalStackLayout Spacing="6">
                        <Border StrokeShape="RoundRectangle 14"
                                Stroke="#7C5D47"
                                BackgroundColor="#3B2616"
                                Padding="14,6">
                            <Entry Text="{Binding PhoneInput, Mode=TwoWay}"
                                   AutomationId="AuthPhoneEntry"
                                   Placeholder="+380000000000"
                                   PlaceholderColor="#A89080"
                                   TextColor="#FFFFFF"
                                   Keyboard="Telephone"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center">
                                <Entry.Behaviors>
                                    <behaviors:PhoneInputBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>

                        <Label Text="Формат: +380XXXXXXXXX (рівно 9 цифр після +380)"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="#C7B6A8" />
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           AutomationId="AuthErrorLabel"
                           IsVisible="{Binding HasMainError}"
                           TextColor="#FCA5A5"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Повідомити про помилку"
                            AutomationId="AuthReportErrorButton"
                            Command="{Binding ReportErrorCommand}"
                            IsVisible="{Binding CanReportMainError}"
                            HorizontalOptions="Center"
                            BackgroundColor="Transparent"
                            BorderColor="#FCA5A5"
                            BorderWidth="1"
                            TextColor="#FCA5A5"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="34"
                            Padding="14,0" />

                    <Button Text="Увійти за біометрією"
                            AutomationId="AuthBiometricLoginButton"
                            Command="{Binding BiometricLoginCommand}"
                            IsVisible="{Binding IsBiometricLoginVisible}"
                            BackgroundColor="#3B2616"
                            BorderColor="#F7A600"
                            BorderWidth="1.5"
                            TextColor="#FDF1D6"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="22"
                            HeightRequest="46" />

                    <Label Text="{Binding BiometricStatusMessage}"
                           IsVisible="{Binding HasBiometricStatusMessage}"
                           TextColor="#E7DCD2"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Policy & Continue CTA -->
            <VerticalStackLayout Grid.Row="2" Spacing="16">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <CheckBox IsChecked="{Binding IsPolicyAccepted, Mode=TwoWay}"
                              AutomationId="AuthPolicyCheckBox"
                              Color="#F7A600" />
                    <Label Text="Погоджуюсь з правилами збору та обробки персональних даних"
                           FontSize="13"
                           TextColor="#E7DCD2"
                           VerticalTextAlignment="Center"
                           MaximumWidthRequest="270" />
                </HorizontalStackLayout>

                <Button Text="Прийняти та продовжити"
                        AutomationId="AuthRequestSmsButton"
                        Command="{Binding RequestSmsCommand}"
                        BackgroundColor="#F7A600"
                        TextColor="#FFFFFF"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="26"
                        HeightRequest="52" />
            </VerticalStackLayout>
        </Grid>

        <!-- SMS Code Modal Popup -->
        <Grid IsVisible="{Binding IsSmsPopupVisible}"
              BackgroundColor="#B3000000"
              Padding="24">
            <Border VerticalOptions="Center"
                    StrokeShape="RoundRectangle 24"
                    Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                    Padding="24">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Підтвердження номера"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />

                    <Label Text="Введіть 4-значний код підтвердження з SMS"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />

                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}"
                            Padding="12,4">
                        <Entry Text="{Binding SmsOtpCode, Mode=TwoWay}"
                               AutomationId="AuthOtpEntry"
                               Placeholder="0000"
                               Keyboard="Numeric"
                               MaxLength="4"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="#DC2626"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Повідомити про помилку"
                            AutomationId="AuthSmsReportErrorButton"
                            Command="{Binding ReportErrorCommand}"
                            IsVisible="{Binding CanReportError}"
                            HorizontalOptions="Center"
                            BackgroundColor="Transparent"
                            BorderColor="#DC2626"
                            BorderWidth="1"
                            TextColor="#DC2626"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="34"
                            Padding="14,0" />

                    <Button Text="Підтвердити код"
                            AutomationId="AuthVerifySmsButton"
                            Command="{Binding VerifySmsCommand}"
                            BackgroundColor="#F7A600"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            CornerRadius="22"
                            HeightRequest="48" />

                    <Button Text="Скасувати"
                            AutomationId="AuthCancelSmsButton"
                            Command="{Binding CloseSmsPopupCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
