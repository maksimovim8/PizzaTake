<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PizzaTake.Core.ViewModels;assembly=PizzaTake.Core"
             xmlns:models="clr-namespace:PizzaTake.Core.Models;assembly=PizzaTake.Core"
             xmlns:converters="clr-namespace:PizzaTake.Converters"
             x:Class="PizzaTake.Views.LogsPage"
             x:DataType="vm:LogsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">

    <ContentPage.Resources>
        <converters:LogFilterChipConverter x:Key="LogFilterChipConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16,12" RowSpacing="12">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="‹ Назад"
                    AutomationId="LogsBackButton"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#EB5E28"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Журнал логів"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                <Label Text="{Binding LogFileInfo}"
                       IsVisible="{Binding IsAdmin}"
                       AutomationId="LogsFileInfoLabel"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="Оновити"
                    IsVisible="{Binding IsAdmin}"
                    AutomationId="LogsRefreshButton"
                    Command="{Binding LoadLogsCommand}"
                    BackgroundColor="#FDF1D6"
                    TextColor="#B45309"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="38"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Admin Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="12" IsVisible="{Binding IsAdmin}">
            <!-- Level Filter Chips -->
            <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Усі"
                        AutomationId="LogsFilterAllButton"
                        Command="{Binding SelectLevelCommand}"
                        CommandParameter="Усі"
                        CornerRadius="16"
                        HeightRequest="36"
                        FontSize="13"
                        FontAttributes="Bold"
                        BorderWidth="1"
                        BackgroundColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Усі|Background'}"
                        TextColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Усі|Text'}"
                        BorderColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Усі|Border'}" />

                <Button Text="Information"
                        AutomationId="LogsFilterInfoButton"
                        Command="{Binding SelectLevelCommand}"
                        CommandParameter="Information"
                        CornerRadius="16"
                        HeightRequest="36"
                        FontSize="13"
                        FontAttributes="Bold"
                        BorderWidth="1"
                        BackgroundColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Information|Background'}"
                        TextColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Information|Text'}"
                        BorderColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Information|Border'}" />

                <Button Text="Warning"
                        AutomationId="LogsFilterWarningButton"
                        Command="{Binding SelectLevelCommand}"
                        CommandParameter="Warning"
                        CornerRadius="16"
                        HeightRequest="36"
                        FontSize="13"
                        FontAttributes="Bold"
                        BorderWidth="1"
                        BackgroundColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Warning|Background'}"
                        TextColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Warning|Text'}"
                        BorderColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Warning|Border'}" />

                <Button Text="Error"
                        AutomationId="LogsFilterErrorButton"
                        Command="{Binding SelectLevelCommand}"
                        CommandParameter="Error"
                        CornerRadius="16"
                        HeightRequest="36"
                        FontSize="13"
                        FontAttributes="Bold"
                        BorderWidth="1"
                        BackgroundColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Error|Background'}"
                        TextColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Error|Text'}"
                        BorderColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Error|Border'}" />

                <Button Text="Fatal"
                        AutomationId="LogsFilterFatalButton"
                        Command="{Binding SelectLevelCommand}"
                        CommandParameter="Fatal"
                        CornerRadius="16"
                        HeightRequest="36"
                        FontSize="13"
                        FontAttributes="Bold"
                        BorderWidth="1"
                        BackgroundColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Fatal|Background'}"
                        TextColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Fatal|Text'}"
                        BorderColor="{Binding SelectedLevel, Converter={StaticResource LogFilterChipConverter}, ConverterParameter='Fatal|Border'}" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Diagnostic Actions & Bug Report -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 16"
                Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                Padding="12">
            <VerticalStackLayout Spacing="10">
                <Entry Text="{Binding BugReportComment, Mode=TwoWay}"
                       AutomationId="LogsBugReportCommentEntry"
                       Placeholder="Опис проблеми (опційно для звіту)..."
                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                       PlaceholderColor="{AppThemeBinding Light=#A8A29E, Dark=#78716C}" />

                <Button Text="Повідомити про помилку"
                        AutomationId="LogsReportBugButton"
                        Command="{Binding SendBugReportCommand}"
                        BackgroundColor="#EB5E28"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="42" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Тест винятку в Task"
                            AutomationId="LogsTestTaskExceptionButton"
                            Command="{Binding TestTaskExceptionCommand}"
                            BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#3A2D1E}"
                            TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="38" />

                    <Button Grid.Column="1"
                            Text="Тест крашу (Sentry)"
                            AutomationId="LogsTestCrashButton"
                            Command="{Binding TestSentryCrashCommand}"
                            BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#3B1D1D}"
                            TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="38" />
                </Grid>

                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       FontSize="12"
                       TextColor="#16A34A" />
            </VerticalStackLayout>
        </Border>

        <!-- Log Entries List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding LogEntries}"
                        AutomationId="LogsCollectionView"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24" Spacing="6">
                    <Label Text="Записів не знайдено"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                    <Label Text="Спробуйте змінити фільтр рівня або натисніть «Оновити»."
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LogEntry">
                    <Border Margin="0,0,0,8"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="10">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0"
                                        Padding="6,2"
                                        BackgroundColor="#E0F2FE">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="Debug">
                                            <Setter Property="BackgroundColor" Value="#E7E5E4" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="Information">
                                            <Setter Property="BackgroundColor" Value="#DBEAFE" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="Warning">
                                            <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="Error">
                                            <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="Fatal">
                                            <Setter Property="BackgroundColor" Value="#7F1D1D" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding LevelShort}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#1E3A8A">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Debug">
                                                <Setter Property="TextColor" Value="#57534E" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Information">
                                                <Setter Property="TextColor" Value="#1D4ED8" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="TextColor" Value="#B45309" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Error">
                                                <Setter Property="TextColor" Value="#B91C1C" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Fatal">
                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding Source}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#44403C, Dark=#D6D3D1}" />

                                <Label Grid.Column="2"
                                       Text="{Binding Timestamp}"
                                       FontSize="11"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            </Grid>

                            <Label Text="{Binding Message}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
