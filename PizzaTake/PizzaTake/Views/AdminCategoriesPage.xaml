<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PizzaTake.Core.ViewModels;assembly=PizzaTake.Core"
             xmlns:models="clr-namespace:PizzaTake.Core.Models;assembly=PizzaTake.Core"
             x:Class="PizzaTake.Views.AdminCategoriesPage"
             x:DataType="vm:AdminCategoriesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="20,14,20,8">
            <Button Text="‹ Назад"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="#EB5E28"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="0" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,4,20,28">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Категорії меню"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                    <Label Text="Додавання, перейменування та порядок категорій (лише адміністратор)"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 18"
                        Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="НАЗВА КАТЕГОРІЇ *"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />

                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#E7E5E4, Dark=#3D342C}"
                                BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}"
                                Padding="12,4">
                            <Entry Text="{Binding NewCategoryName, Mode=TwoWay}"
                                   AutomationId="AdminCategoryNameEntry"
                                   Placeholder="Наприклад: Десерти або Комбо"
                                   PlaceholderColor="{AppThemeBinding Light=#A8A29E, Dark=#78716C}"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                                   FontSize="15" />
                        </Border>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="#DC2626"
                               FontSize="13" />

                        <Label Text="{Binding StatusMessage}"
                               IsVisible="{Binding HasStatusMessage}"
                               TextColor="#16A34A"
                               FontSize="13"
                               FontAttributes="Bold" />

                        <HorizontalStackLayout Spacing="10">
                            <Button Text="{Binding SaveButtonText}"
                                    AutomationId="AdminCategorySaveButton"
                                    Command="{Binding SaveCategoryCommand}"
                                    BackgroundColor="#EB5E28"
                                    TextColor="#FFFFFF"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="18"
                                    HeightRequest="42"
                                    Padding="18,0" />
                            <Button Text="Скасувати"
                                    IsVisible="{Binding IsEditing}"
                                    Command="{Binding CancelEditCommand}"
                                    BackgroundColor="Transparent"
                                    BorderColor="#A8A29E"
                                    BorderWidth="1"
                                    TextColor="{AppThemeBinding Light=#78716C, Dark=#D6D3D1}"
                                    FontSize="13"
                                    CornerRadius="18"
                                    HeightRequest="42"
                                    Padding="14,0" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Categories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductCategory">
                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                                    Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                    <Button Grid.Column="1"
                                            Text="↑"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminCategoriesViewModel}}, Path=MoveUpCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#F3F0EA, Dark=#332A23}"
                                            TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                                            CornerRadius="12"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0" />
                                    <Button Grid.Column="2"
                                            Text="↓"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminCategoriesViewModel}}, Path=MoveDownCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#F3F0EA, Dark=#332A23}"
                                            TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                                            CornerRadius="12"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0" />
                                    <Button Grid.Column="3"
                                            Text="✎"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminCategoriesViewModel}}, Path=StartEditCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FDF1D6"
                                            TextColor="#B45309"
                                            CornerRadius="12"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0" />
                                    <Button Grid.Column="4"
                                            Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminCategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#DC2626"
                                            CornerRadius="12"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
