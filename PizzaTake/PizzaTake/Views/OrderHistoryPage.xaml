<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PizzaTake.ViewModels"
             xmlns:models="clr-namespace:PizzaTake.Models"
             xmlns:converters="clr-namespace:PizzaTake.Converters"
             x:Class="PizzaTake.Views.OrderHistoryPage"
             x:DataType="vm:OrderHistoryViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">

    <ContentPage.Resources>
        <converters:OrderProgressConverter x:Key="OrderProgressConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="20,16">
        <VerticalStackLayout Grid.Row="0" Spacing="2" Margin="0,0,0,14">
            <Label Text="Історія замовлень"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
            <Label Text="Ваші попередні та поточні замовлення"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <Border IsVisible="{Binding IsSessionLocked}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#F7A600"
                        BackgroundColor="{AppThemeBinding Light=#FFFDF7, Dark=#2B2219}"
                        Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔒 Сесію заблоковано"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                        <Label Text="Розблокуйте сесію за біометрією або SMS, щоб переглядати історію замовлень."
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                        <Button Text="Розблокувати сесію"
                                Command="{Binding UnlockSessionCommand}"
                                BackgroundColor="#EB5E28"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                CornerRadius="20"
                                HeightRequest="44" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsEmpty}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                        Padding="24">
                    <Label Text="У вас ще немає замовлень"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                </Border>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding PastOrders}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Border StrokeShape="RoundRectangle 20"
                                    Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                                    Padding="16">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding OrderNumber, StringFormat='№ {0}'}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding CreatedAtUtc, StringFormat='{0:dd.MM.yyyy · HH:mm}'}"
                                               FontSize="12"
                                               VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                                    </Grid>

                                    <Label Text="{Binding Status, Converter={StaticResource OrderProgressConverter}}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{Binding Status, Converter={StaticResource OrderProgressConverter}, ConverterParameter=Color}" />

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2"
                                                 Color="{Binding Status, Converter={StaticResource OrderProgressConverter}, ConverterParameter=Step1Color}" />
                                        <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2"
                                                 Color="{Binding Status, Converter={StaticResource OrderProgressConverter}, ConverterParameter=Step2Color}" />
                                        <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2"
                                                 Color="{Binding Status, Converter={StaticResource OrderProgressConverter}, ConverterParameter=Step3Color}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                        <Label Text="Разом"
                                               FontSize="14"
                                               VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TotalAmount, StringFormat='{0:0.##} ₴'}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               TextColor="#EB5E28" />
                                        <Button Grid.Column="2"
                                                Text="Деталі"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderHistoryViewModel}}, Path=OpenDetailCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FDF1D6"
                                                TextColor="#B45309"
                                                FontAttributes="Bold"
                                                CornerRadius="16"
                                                HeightRequest="36"
                                                Padding="16,0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
