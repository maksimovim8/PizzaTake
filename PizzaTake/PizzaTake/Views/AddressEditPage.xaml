<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PizzaTake.ViewModels"
             x:Class="PizzaTake.Views.AddressEditPage"
             x:DataType="vm:AddressEditViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">

    <ScrollView Padding="20,16">
        <VerticalStackLayout Spacing="18">
            <Button Text="‹ Назад"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="#EB5E28"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="0" />

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                <Label Text="Збережіть адресу для швидкого оформлення замовлення"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 18"
                    Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="НАЗВА АДРЕСИ"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#E7E5E4, Dark=#3D342C}"
                                BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}"
                                Padding="12,4">
                            <Entry Text="{Binding Label, Mode=TwoWay}"
                                   Placeholder="Наприклад: Дім, Робота"
                                   PlaceholderColor="{AppThemeBinding Light=#A8A29E, Dark=#78716C}"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                                   FontSize="15" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="АДРЕСА ДОСТАВКИ *"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#E7E5E4, Dark=#3D342C}"
                                BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}"
                                Padding="12,4">
                            <Entry Text="{Binding AddressText, Mode=TwoWay}"
                                   Placeholder="вул. Хрещатик, 22, кв. 15"
                                   PlaceholderColor="{AppThemeBinding Light=#A8A29E, Dark=#78716C}"
                                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                                   FontSize="15" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="#DC2626"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Зберегти адресу"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#EB5E28"
                    TextColor="#FFFFFF"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    HeightRequest="50" />

            <Button Text="Видалити адресу"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditMode}"
                    BackgroundColor="Transparent"
                    BorderColor="#DC2626"
                    BorderWidth="1"
                    TextColor="#DC2626"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    HeightRequest="46" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
