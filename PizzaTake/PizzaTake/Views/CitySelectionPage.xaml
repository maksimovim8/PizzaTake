<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PizzaTake.Views.CitySelectionPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PizzaTake.Core.Models;assembly=PizzaTake.Core"
    Title="Оберіть місто"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12" BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Text="‹ Назад" AutomationId="CityBackButton" Command="{Binding GoBackCommand}" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#242424, Dark=#F5F5F4}" Padding="0" HorizontalOptions="Start" />
            <Label Grid.Column="1" Text="Оберіть місто" FontSize="26" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" VerticalOptions="Center" />
        </Grid>
        <Entry Grid.Row="1" AutomationId="CitySearchEntry" Placeholder="Пошук міста" Text="{Binding SearchText, Mode=TwoWay}" />
        <Button Grid.Row="2"
                Text="📍 Знайти найближче місто"
                AutomationId="CityFindNearbyButton"
                Command="{Binding FindNearbyCommand}"
                BackgroundColor="#EB5E28"
                TextColor="#FFFFFF"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="20"
                HeightRequest="46" />
        <Label Grid.Row="3" AutomationId="CityStatusLabel" Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light=#777777, Dark=#A8A29E}" />
        <CollectionView Grid.Row="4" AutomationId="CityListCollectionView" ItemsSource="{Binding Cities}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:City">
                    <Button Text="{Binding Name}" HorizontalOptions="Fill"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                            BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#3D342C}" BorderWidth="1"
                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectCityCommand}"
                            CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
