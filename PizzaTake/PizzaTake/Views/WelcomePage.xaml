<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PizzaTake.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PizzaTake.Models"
    Title="Вітаємо">
    <VerticalStackLayout Padding="28" Spacing="20" VerticalOptions="Center">
        <Label Text="PIZZA.TAKE!" FontSize="32" FontAttributes="Bold" TextColor="#F15A24" HorizontalOptions="Center" />
        <Label Text="Раді тебе бачити!" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Оберіть, як бажаєте отримати замовлення" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        <Button Text="Доставка" BackgroundColor="#FFB400" TextColor="White" CornerRadius="18"
                Command="{Binding SelectDeliveryCommand}" CommandParameter="{x:Static models:DeliveryType.Delivery}" />
        <Button Text="Самовивіз" BackgroundColor="#FFB400" TextColor="White" CornerRadius="18"
                Command="{Binding SelectDeliveryCommand}" CommandParameter="{x:Static models:DeliveryType.Pickup}" />
    </VerticalStackLayout>
</ContentPage>
