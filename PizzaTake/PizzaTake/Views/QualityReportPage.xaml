<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PizzaTake.ViewModels"
             xmlns:models="clr-namespace:PizzaTake.Models"
             x:Class="PizzaTake.Views.QualityReportPage"
             x:DataType="vm:QualityReportViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">

    <Grid RowDefinitions="Auto,*" Padding="20,16" RowSpacing="12">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="‹ Назад"
                    AutomationId="QualityReportBackButton"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#EB5E28"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="0"
                    HorizontalOptions="Start" />
            <Label Grid.Column="1"
                   Text="Контроль якості"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
            <Button Grid.Column="2"
                    Text="Карта"
                    AutomationId="QualityReportOpenMapButton"
                    Command="{Binding OpenMapCommand}"
                    BackgroundColor="#FDF1D6"
                    TextColor="#B45309"
                    FontSize="13"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="34"
                    Padding="12,0"
                    VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,24">
                <!-- New Report Form -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding OrderContextText}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#EB5E28" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="НОМЕР ЗАМОВЛЕННЯ (НЕОБОВ'ЯЗКОВО)"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#E7E5E4, Dark=#3D342C}"
                                    BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}"
                                    Padding="12,4">
                                <Entry Text="{Binding OrderNumber, Mode=TwoWay}"
                                       AutomationId="QualityReportOrderNumberEntry"
                                       Placeholder="Наприклад: PD-1234"
                                       PlaceholderColor="{AppThemeBinding Light=#A8A29E, Dark=#78716C}"
                                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                                       FontSize="15" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="ОПИС ЗВЕРНЕННЯ *"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#E7E5E4, Dark=#3D342C}"
                                    BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}"
                                    Padding="12,6">
                                <Editor Text="{Binding Description, Mode=TwoWay}"
                                        AutomationId="QualityReportDescriptionEditor"
                                        Placeholder="Опишіть стан піци, пакування або доставки..."
                                        PlaceholderColor="{AppThemeBinding Light=#A8A29E, Dark=#78716C}"
                                        TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}"
                                        HeightRequest="90"
                                        FontSize="15" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Photo Controls -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ФОТОГРАФІЯ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="📷 Камера"
                                        AutomationId="QualityReportTakePhotoButton"
                                        Command="{Binding TakePhotoCommand}"
                                        BackgroundColor="#FDF1D6"
                                        TextColor="#B45309"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        CornerRadius="16"
                                        HeightRequest="42" />
                                <Button Grid.Column="1"
                                        Text="🖼 Галерея"
                                        AutomationId="QualityReportPickPhotoButton"
                                        Command="{Binding PickPhotoCommand}"
                                        BackgroundColor="#FDF1D6"
                                        TextColor="#B45309"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        CornerRadius="16"
                                        HeightRequest="42" />
                            </Grid>

                            <Border IsVisible="{Binding HasPhoto}"
                                    StrokeShape="RoundRectangle 14"
                                    Stroke="{AppThemeBinding Light=#E7E5E4, Dark=#3D342C}"
                                    BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}"
                                    Padding="8">
                                <VerticalStackLayout Spacing="6">
                                    <Image Source="{Binding PhotoPath}"
                                           AutomationId="QualityReportPhotoPreview"
                                           Aspect="AspectFill"
                                           HeightRequest="170" />
                                    <Label Text="✓ Фото прикріплено"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#16A34A" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Geolocation Controls -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ГЕОЛОКАЦІЯ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{Binding CoordinatesText}"
                                       AutomationId="QualityReportCoordinatesLabel"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                <Button Grid.Column="1"
                                        Text="📍 Мої координати"
                                        AutomationId="QualityReportGetLocationButton"
                                        Command="{Binding GetLocationCommand}"
                                        BackgroundColor="#FDF1D6"
                                        TextColor="#B45309"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="16"
                                        HeightRequest="38"
                                        Padding="14,0" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Status / Error -->
                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               AutomationId="QualityReportErrorLabel"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#DC2626" />

                        <Label Text="{Binding StatusMessage}"
                               IsVisible="{Binding HasStatusMessage}"
                               AutomationId="QualityReportStatusLabel"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#16A34A" />

                        <Button Text="Зберегти звернення"
                                AutomationId="QualityReportSaveButton"
                                Command="{Binding SaveReportCommand}"
                                BackgroundColor="#EB5E28"
                                TextColor="#FFFFFF"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="24"
                                HeightRequest="48" />
                    </VerticalStackLayout>
                </Border>

                <!-- Saved Reports List -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Збережені звернення"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />

                    <Border IsVisible="{Binding HasNoSavedReports}"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="16">
                        <Label Text="Поки немає збережених звернень щодо якості."
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                    </Border>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding HasSavedReports}"
                                         BindableLayout.ItemsSource="{Binding SavedReports}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:QualityReport">
                                <Border StrokeShape="RoundRectangle 16"
                                        Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding OrderBadgeText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#EB5E28" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding CreatedAtLocalText}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                                        </Grid>

                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />

                                        <Image Source="{Binding PhotoPath}"
                                               IsVisible="{Binding HasPhoto}"
                                               Aspect="AspectFill"
                                               HeightRequest="130" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding CoordinatesText}"
                                                   FontSize="12"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                                            <Button Grid.Column="1"
                                                    Text="Видалити"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QualityReportViewModel}}, Path=DeleteReportCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#DC2626"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    Padding="8,0"
                                                    HeightRequest="30" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
