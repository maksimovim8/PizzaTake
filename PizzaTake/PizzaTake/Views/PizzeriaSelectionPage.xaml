<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PizzaTake.Views.PizzeriaSelectionPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PizzaTake.Core.Models;assembly=PizzaTake.Core"
    Title="Оберіть піцерію"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">
    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="14" BackgroundColor="{AppThemeBinding Light=#F9F7F2, Dark=#181411}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Text="‹ Назад"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#242424, Dark=#F5F5F4}"
                    Padding="0"
                    HorizontalOptions="Start" />
            <Label Grid.Column="1" Text="Оберіть піцерію" FontSize="26" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Pizzerias}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Pizzeria">
                    <Border Margin="0,0,0,10"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light=#EAE5DC, Dark=#3D342C}"
                            StrokeThickness="1.5"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#26201B}"
                            Padding="14">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="#EB5E28" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF7E6, Dark=#3A2D1E}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectPizzeriaCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding StoreNumber, StringFormat='Піцерія № {0}'}" FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1C1917, Dark=#F5F5F4}" />
                                <Label Text="{Binding Address}" FontSize="14" TextColor="{AppThemeBinding Light=#44403C, Dark=#D6D3D1}" />
                                <Label Text="{Binding WorkingHoursText, StringFormat='Години: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light=#78716C, Dark=#A8A29E}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="{Binding SelectButtonText}"
                                    BackgroundColor="#FDF1D6"
                                    TextColor="#B45309"
                                    FontAttributes="Bold"
                                    CornerRadius="16"
                                    HeightRequest="38"
                                    Padding="14,0"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectPizzeriaCommand}"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#EB5E28" />
                                        <Setter Property="TextColor" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="2" Text="Підтвердити" BackgroundColor="#FFB400" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="22" HeightRequest="48" Command="{Binding ConfirmPizzeriaCommand}" />
    </Grid>
</ContentPage>
